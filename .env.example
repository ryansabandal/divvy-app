# Copy this file to .env and fill in real values — .env is gitignored and never committed.
# This matches the local Postgres container defined in compose.yml.
#
# Production (Vercel) uses Supabase's pooled connection string instead — set directly in the
# Vercel dashboard per environment, never written here: postgresql://...:6543/postgres?pgbouncer=true
# The direct (5432) Supabase string is for the Prisma CLI only (migrations), also never in Vercel.

DATABASE_URL="postgresql://divvy:divvy@localhost:5432/divvy"

# Supabase Storage — server-side only, never NEXT_PUBLIC_*. See CLAUDE.md's "V2 File Uploads —
# Locked Constraints" section. The secret key bypasses RLS entirely; it must never reach the
# browser bundle or a NEXT_PUBLIC_* var.
#
# On Vercel: set on Production AND Preview, but with different SUPABASE_STORAGE_PREFIX values —
# "" (unset) on Production, "preview/" on Preview — so preview-branch uploads don't land in the
# same object namespace as real user data. Local dev uses "dev/", also folder-scoped in the same
# shared bucket, since there's no local Supabase Storage (the Supabase CLI needs Docker, which
# conflicts with this project's Podman-only local dev).
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="<service_role / secret key — from Project Settings, never the anon/publishable key>"
SUPABASE_STORAGE_BUCKET="divvy-uploads"
SUPABASE_STORAGE_PREFIX="dev/"
