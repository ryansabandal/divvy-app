// Tells Prisma to generate a TypeScript client for use in the app
generator client {
  provider = "prisma-client-js"
}

// Connection URL now lives in prisma.config.ts (Prisma 7 no longer reads it from the schema)
datasource db {
  provider = "postgresql"
}

// A bill-splitting session created by one person and shared with the group
model Session {
  id           String        @id @default(uuid())
  name         String
  created_at   DateTime      @default(now())
  participants Participant[]
  expenses     Expense[]
  settlements  Settlement[]
}

// A person in a session who can pay for or owe a share of expenses
model Participant {
  id                  String             @id @default(uuid())
  session_id          String
  name                String
  // Self-entered later via the shared session link, so both are nullable
  payment_method_type PaymentMethodType?
  payment_details     String?
  // Supabase Storage object path for an uploaded QR code, e.g. "qr/<sessionId>/<uuid>.jpg"; null
  // when none uploaded. One shared slot, not one per payment method — confirmed by the user that a
  // GCash-generated QR scans fine in a bank app (BPI), consistent with QR Ph's interoperability.
  // Stores the path, not the public URL — publicObjectUrl() derives the URL at serialize time, so
  // a bucket rename is a config change, not a data migration. Supplements
  // payment_method_type/payment_details, never replaces them.
  qr_object_path      String?
  created_at          DateTime           @default(now())
  // A monotonic insert sequence, used only to keep participant lists in a stable order.
  // created_at can't do this alone: Postgres's now() returns the *transaction* start time, so
  // participants created together in one nested write (the common case) would tie — and an
  // UPDATE (e.g. setting a payment method) can otherwise make Postgres return rows in a
  // different physical order than before.
  sort_order          Int                @default(autoincrement())
  // Cascades on Session delete, same as Settlement.session below — needed for the pg_cron monthly
  // cleanup job (see CLAUDE.md) to delete a Session in one statement. Previously RESTRICT, on the
  // reasoning that an accidental delete path should fail loudly; now that a real delete path is
  // intentional, cascading is the correct behavior rather than a workaround.
  session             Session            @relation(fields: [session_id], references: [id], onDelete: Cascade)
  expenses            Expense[]
  splits              ExpenseSplit[]
  // debtor/creditor deliberately don't cascade either: no route deletes a Participant today, and
  // if one ever does, a loud FK error beats silently vanishing one side of a payment plan
  owes                Settlement[]       @relation("Debtor")
  owed                Settlement[]       @relation("Creditor")

  // Covers the session -> participants lookup FK; Postgres doesn't auto-index FK columns
  @@index([session_id])
}

// A single expense logged against a session, paid by one participant
model Expense {
  id          String         @id @default(uuid())
  session_id  String
  paid_by     String
  amount      Float
  description String
  split_type  SplitType
  // Total units for a QUANTITY split (e.g. 6 shots); null for EVEN/CUSTOM
  quantity    Int?
  // Monotonic insert sequence, same pattern as Participant.sort_order: keeps the expense list in
  // a stable order and lets users drag-reorder it, since insertion order alone isn't guaranteed
  sort_order  Int            @default(autoincrement())
  // Cascades on Session delete, same reasoning as Participant.session above
  session     Session        @relation(fields: [session_id], references: [id], onDelete: Cascade)
  payer       Participant    @relation(fields: [paid_by], references: [id])
  splits      ExpenseSplit[]

  // Covers the session -> expenses and payer -> expenses FKs
  @@index([session_id])
  @@index([paid_by])
}

// How much of a given expense one participant owes
model ExpenseSplit {
  id             String      @id @default(uuid())
  expense_id     String
  participant_id String
  amount_owed    Float
  // Units this participant consumed in a QUANTITY split; null for EVEN/CUSTOM
  units          Int?
  expense        Expense     @relation(fields: [expense_id], references: [id], onDelete: Cascade)
  // Cascades on Participant delete too, unlike Settlement.debtor/creditor below. Without this the
  // pg_cron retention job could not delete a single session that had expenses: ExpenseSplit is two
  // hops from Session (reachable only via Expense), so Postgres runs the Participant cascade's
  // referential check before the Expense -> ExpenseSplit cascade has cleared these rows, and
  // `DELETE FROM "Session"` fails with 23503. Settlement escapes that only because it hangs
  // directly off Session — one hop — which is why the gap wasn't visible by reading the schema.
  //
  // The "loud FK error" reasoning that keeps the Settlement FKs restrictive is weakest here: a
  // split has no life independent of its expense (it already cascades from one), so it is not a
  // record anyone would want preserved after its participant is gone.
  participant    Participant @relation(fields: [participant_id], references: [id], onDelete: Cascade)

  // Covers the expense -> splits and participant -> splits FKs
  @@index([expense_id])
  @@index([participant_id])
}

// A frozen, simplified payment from one participant to another; persisted when the
// settlement plan is locked in, then flipped to paid as the money actually changes hands
model Settlement {
  id         String      @id @default(uuid())
  session_id String
  from_id    String
  to_id      String
  amount     Float
  // Whether this payment has actually been made; toggled from the settle screen
  paid       Boolean     @default(false)
  // Cascades on Session delete, same as Participant.session/Expense.session above. Those three
  // plus ExpenseSplit.participant (see above) are what make `DELETE FROM "Session"` a
  // single-statement, fully cascading delete, which the pg_cron monthly cleanup job (see
  // CLAUDE.md) relies on. The three alone were NOT enough — that was ticket 26: the claim was
  // reasoned about but never executed, and the job could not delete any session with expenses.
  // debtor/creditor deliberately don't cascade: no route deletes a Participant on its own today,
  // and if one ever does, a loud FK error beats silently vanishing one side of a payment plan.
  session    Session     @relation(fields: [session_id], references: [id], onDelete: Cascade)
  debtor     Participant @relation("Debtor", fields: [from_id], references: [id])
  creditor   Participant @relation("Creditor", fields: [to_id], references: [id])

  // Covers the session -> settlements, debtor -> settlements, and creditor -> settlements FKs
  @@index([session_id])
  @@index([from_id])
  @@index([to_id])
}

// How an expense is divided: equally, by manual amounts, or by units consumed
enum SplitType {
  EVEN
  CUSTOM
  QUANTITY
}

// How a participant wants to receive money owed to them
enum PaymentMethodType {
  GCASH
  MAYA
  BANK_TRANSFER
}
